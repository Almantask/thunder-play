rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Ratings, play history and playlists. Anonymous auth is enough: the app is personal, and the
    // data lives at a fixed path rather than under a uid so every device shares one library.
    match /libraries/{libraryId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // A shared playlist is world-readable by design - that is the point of the link - but only
    // until it expires. Expiry is enforced here as well as in the player and the cleanup job, so
    // a lapsed link stops working even if the audio has not been swept up yet.
    match /shares/{shareId} {
      allow read: if resource.data.revoked == false
                  && resource.data.expiresAt > request.time.toMillis();
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
