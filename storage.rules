rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Audio for shared playlists. Public reads are required: recipients have no account.
    // Revoking a share deletes these objects, which is the real off-switch.
    match /shares/{shareId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
